# Build trees (regenerated by build.bat / build-x86.bat)
build/
build_x86/
out/

# Local clones of third-party reference projects used while reverse engineering.
# They carry their own licenses and are NOT part of this repository.
ref/

# Runtime state written next to the executable
bridge.ini
profiles/*.local.ini
*.log

# Editor / OS noise
.vs/
.idea/
.cache/
*.user
Thumbs.db
Desktop.ini

# Packaging output that is not the tracked release archive
*.tmp

# Packaged output; published as a release asset, not committed
release/
